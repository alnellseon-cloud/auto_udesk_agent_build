# 复制为 .env 后填写真实值；不要提交 .env。

# 必填：当前部署环境的平台地址。仓库不预置任何真实环境域名。
UAGENT_BASE_URL=https://your-uagent-host.example.com

# 认证方式一：短期 Bearer Token。
UAGENT_TOKEN=Bearer your_token_here

# 认证方式二：自动登录。若不使用，请留空。
UAGENT_EMAIL=your_email@example.com
UAGENT_PASSWORD_MD5=your_password_md5_here
UC_BASE_URL=https://your-user-center-host.example.com
